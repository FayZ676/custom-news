#!/bin/bash

set -e

echo "Checking for backend changes..."

# Get the remote tracking branch
remote="$1"
url="$2"

# Check if there are any changes in openfeed-backend directory
# Compare against the remote branch we're pushing to
if git diff --name-only origin/main HEAD | grep -q "^openfeed-backend/"; then
    echo "Backend changes detected, checking which tests to run..."
    
    cd "$(git rev-parse --show-toplevel)/openfeed-backend"

    # Get list of changed files
    changed_files=$(git diff --name-only origin/main..HEAD)

    # Check if ingestion-related files changed
    if echo "$changed_files" | grep -qE "openfeed-backend/(openfeed/ingestion.py|openfeed/fixtures/feeds.json)"; then
        echo "→ Ingestion-related files changed, running ingestion tests..."
        pytest tests/test_ingestion.py -v
    else
        echo "→ No ingestion-related changes, skipping ingestion tests."
    fi

    echo "✓ All required tests passed!"
else
    echo "No backend changes detected, skipping tests."
fi