PG_CONN = postgresql://postgres:postgres@localhost:54322/postgres
SNAPSHOT_DIR = /tmp/_openfeed_snapshot
# Every table holding data that should survive a reset, in foreign-key order.
# global_settings is left out because the seed recreates it.
SNAPSHOT_TABLES = user_settings user_feedback user_interests user_articles global_emails global_share_links
# user_articles.search_vector is generated, so it can't be copied back in.
COLS_user_articles = id,user_id,source_name,title,url,summary,image_url,published_at,created_at,interest_id,read_at

snapshot:
	mkdir -p $(SNAPSHOT_DIR) \
		$(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "\copy (SELECT $(or $(COLS_$t),*) FROM public.$t) TO '$(SNAPSHOT_DIR)/$t.csv' CSV HEADER") \
		&& echo "Snapshot saved to $(SNAPSHOT_DIR)"

restore_snapshot:
	true $(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "TRUNCATE public.$t CASCADE;") \
		$(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "\copy public.$t $(if $(COLS_$t),($(COLS_$t))) FROM '$(SNAPSHOT_DIR)/$t.csv' CSV HEADER")

reset_db:
	supabase stop --no-backup \
		&& rm -rf migrations/*_create_all.sql .branches .temp

deploy:
	supabase db diff -f create_all \
		&& supabase start \
		&& supabase migration up

gen_types_ts:
	supabase gen types typescript --local > ../../openfeed-frontend/lib/supabase/supabase.types.ts

init: snapshot reset_db deploy gen_types_ts restore_snapshot
