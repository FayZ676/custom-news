PG_CONN = postgresql://postgres:postgres@localhost:54322/postgres
SETTINGS_SNAPSHOT = /tmp/_user_settings_snapshot.csv
FEEDBACK_SNAPSHOT = /tmp/_user_feedback_snapshot.csv
INTERESTS_SNAPSHOT = /tmp/_user_interests_snapshot.csv
ARTICLES_SNAPSHOT = /tmp/_user_articles_snapshot.csv
ARTICLES_COLS = id,user_id,source_name,title,url,summary,image_url,published_at,created_at,interest_id,source_key,read_at

snapshot:
	psql "$(PG_CONN)" -c "\copy public.user_settings TO '$(SETTINGS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_feedback TO '$(FEEDBACK_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_interests TO '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy (SELECT $(ARTICLES_COLS) FROM public.user_articles) TO '$(ARTICLES_SNAPSHOT)' CSV HEADER" \
		&& echo "Snapshot saved to /tmp/"

restore_snapshot:
	psql "$(PG_CONN)" -c "TRUNCATE public.user_settings CASCADE;" \
		&& psql "$(PG_CONN)" -c "\copy public.user_settings FROM '$(SETTINGS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "TRUNCATE public.user_feedback CASCADE;" \
		&& psql "$(PG_CONN)" -c "\copy public.user_feedback FROM '$(FEEDBACK_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "TRUNCATE public.user_interests CASCADE;" \
		&& psql "$(PG_CONN)" -c "\copy public.user_interests FROM '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_articles ($(ARTICLES_COLS)) FROM '$(ARTICLES_SNAPSHOT)' CSV HEADER"

reset_db:
	supabase stop --no-backup \
		&& rm -rf migrations/*_create_all.sql .branches .temp

deploy:
	supabase db diff -f create_all \
		&& supabase start \
		&& supabase migration up

gen_types_ts:
	supabase gen types typescript --local > ../../openfeed-frontend/lib/supabase/supabase.types.ts

init: snapshot reset_db deploy gen_types_ts restore_snapshot
