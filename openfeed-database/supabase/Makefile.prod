include ../.env.prod

# DATABASE_URL comes from .env.prod: the Session pooler connection string from the
# Supabase dashboard (Connect → Session pooler). The direct db.<ref> host is
# IPv6-only, so the pooler is what works everywhere.
SNAPSHOT_DIR = /tmp/_openfeed_snapshot
# A reset wipes auth too, so accounts are snapshotted along with the data.
AUTH_TABLES = auth.users auth.identities
# Tables whose data should survive a reset. global_settings and global_feeds
# are left out because the seeds recreate them.
PUBLIC_TABLES = user_settings user_feedback user_interests global_articles user_article_matches user_articles global_emails global_share_links

snapshot:
	rm -rf $(SNAPSHOT_DIR) && mkdir -p $(SNAPSHOT_DIR) \
		&& pg_dump "$(DATABASE_URL)" --data-only $(foreach t,$(AUTH_TABLES),-t $t) -f $(SNAPSHOT_DIR)/auth.sql \
		&& pg_dump "$(DATABASE_URL)" --data-only $(foreach t,$(PUBLIC_TABLES),-t public.$t) -f $(SNAPSHOT_DIR)/public.sql \
		&& echo "Snapshot saved to $(SNAPSHOT_DIR)"

# Restoring users fires the trigger that creates default user_settings, which
# would collide with the snapshotted ones, so those defaults are cleared first.
restore_snapshot:
	psql "$(DATABASE_URL)" -v ON_ERROR_STOP=1 -f $(SNAPSHOT_DIR)/auth.sql \
		&& psql "$(DATABASE_URL)" -c "TRUNCATE public.user_settings;" \
		&& psql "$(DATABASE_URL)" -v ON_ERROR_STOP=1 -f $(SNAPSHOT_DIR)/public.sql

# Wipes the database and applies the local migrations.
reset:
	supabase db reset --db-url "$(DATABASE_URL)" --no-seed --yes

seed:
	for f in seeds/shared/*.sql seeds/prod/*.sql; do \
		psql "$(DATABASE_URL)" -v ON_ERROR_STOP=1 -f $$f || exit 1; \
	done

# Applies migrations not yet on the database, without wiping it.
deploy:
	supabase db push --db-url "$(DATABASE_URL)" --include-all --yes

# Seeds run last so the seeded accounts skip users that were restored.
init: snapshot reset restore_snapshot seed
