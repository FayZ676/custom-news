include ../.env.prod

PG_CONN = postgresql://postgres:$(PROJECT_PASSWORD)@db.$(PROJECT_ID).supabase.co:5432/postgres
SNAPSHOT_DIR = /tmp/_openfeed_snapshot
# Every table holding data that should survive a reset, in foreign-key order.
# global_settings and global_feeds are left out because the seeds recreate them.
SNAPSHOT_TABLES = user_settings user_feedback user_interests global_articles user_article_matches user_articles global_emails global_share_links
# global_articles.search_vector is generated, so it can't be copied back in.
COLS_global_articles = id,source_name,title,url,summary,image_url,published_at,created_at,embedding

snapshot:
	mkdir -p $(SNAPSHOT_DIR) \
		$(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "\copy (SELECT $(or $(COLS_$t),*) FROM public.$t) TO '$(SNAPSHOT_DIR)/$t.csv' CSV HEADER") \
		&& echo "Snapshot saved to $(SNAPSHOT_DIR)"

restore_snapshot:
	true $(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "TRUNCATE public.$t CASCADE;") \
		$(foreach t,$(SNAPSHOT_TABLES),&& psql "$(PG_CONN)" -c "\copy public.$t $(if $(COLS_$t),($(COLS_$t))) FROM '$(SNAPSHOT_DIR)/$t.csv' CSV HEADER") \
		&& psql "$(PG_CONN)" -c "INSERT INTO public.user_settings (user_id) SELECT id FROM auth.users ON CONFLICT (user_id) DO NOTHING;"

reset:
	supabase link --project-ref $(PROJECT_ID) \
		&& mv migrations /tmp/_migrations_backup \
		&& mv seeds /tmp/_seeds_backup \
		&& supabase db reset --linked --yes \
		; mv /tmp/_migrations_backup migrations \
		; mv /tmp/_seeds_backup seeds

seed:
	supabase link --project-ref $(PROJECT_ID) \
		&& for f in seeds/shared/*.sql seeds/prod/*.sql; do \
			psql "$(PG_CONN)" -f $$f; \
		done

deploy:
	supabase link --project-ref $(PROJECT_ID) \
		&& supabase db push --include-all --yes

update:
	supabase link --project-ref $(PROJECT_ID) \
		&& supabase db push --include-all

init: snapshot reset deploy seed restore_snapshot
