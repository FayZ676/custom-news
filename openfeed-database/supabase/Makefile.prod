include ../.env.prod

PG_CONN = postgresql://postgres:$(PROJECT_PASSWORD)@db.$(PROJECT_ID).supabase.co:5432/postgres
INTERESTS_SNAPSHOT = /tmp/_user_interests_snapshot.csv
SETTINGS_SNAPSHOT = /tmp/_user_settings_snapshot.csv
ARTICLES_SNAPSHOT = /tmp/_global_articles_snapshot.csv
STORIES_SNAPSHOT = /tmp/_global_stories_snapshot.csv

snapshot:
	psql "$(PG_CONN)" -c "\copy public.user_interests TO '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_settings TO '$(SETTINGS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.global_articles TO '$(ARTICLES_SNAPSHOT)' CSV HEADER" \
		&& echo "Snapshot saved to /tmp/"

restore_snapshot:
	psql "$(PG_CONN)" -c "TRUNCATE public.global_articles, public.global_stories, public.user_interests, public.user_settings CASCADE;" \
		&& psql "$(PG_CONN)" -c "\copy public.global_articles FROM '$(ARTICLES_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_interests FROM '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_settings FROM '$(SETTINGS_SNAPSHOT)' CSV HEADER"

snapshot_users:
	psql "$(PG_CONN)" -c "\copy public.user_interests TO '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_settings TO '$(SETTINGS_SNAPSHOT)' CSV HEADER" \
		&& echo "User snapshot saved to /tmp/"

restore_snapshot_users:
	psql "$(PG_CONN)" -c "TRUNCATE public.user_interests, public.user_settings CASCADE;" \
		&& psql "$(PG_CONN)" -c "\copy public.user_interests FROM '$(INTERESTS_SNAPSHOT)' CSV HEADER" \
		&& psql "$(PG_CONN)" -c "\copy public.user_settings FROM '$(SETTINGS_SNAPSHOT)' CSV HEADER"

fetch_articles:
	curl -i --location --request POST '$(BACKEND_URL)/global/articles' \
		--header 'x-api-key: $(BACKEND_API_KEY)' \
		--header 'Content-Type: application/json';

reset:
	supabase link --project-ref $(PROJECT_ID) \
		&& mv migrations /tmp/_migrations_backup \
		&& mv seeds /tmp/_seeds_backup \
		&& supabase db reset --linked --yes \
		; mv /tmp/_migrations_backup migrations \
		; mv /tmp/_seeds_backup seeds

seed:
	supabase link --project-ref $(PROJECT_ID) \
		&& for f in seeds/shared/*.sql seeds/prod/*.sql; do \
			psql "$(PG_CONN)" -f $$f; \
		done

deploy:
	supabase link --project-ref $(PROJECT_ID) \
		&& supabase db push --include-all --yes \
		&& supabase secrets set \
			BACKEND_URL=$(BACKEND_URL) \
			BACKEND_API_KEY=$(BACKEND_API_KEY) \
		&& echo " \
			DELETE FROM vault.secrets WHERE name IN ('backend_url', 'backend_api_key'); \
			SELECT vault.create_secret('$(BACKEND_URL)', 'backend_url'); \
			SELECT vault.create_secret('$(BACKEND_API_KEY)', 'backend_api_key'); \
		" | psql "$(PG_CONN)"

update:
	supabase link --project-ref $(PROJECT_ID) \
		&& supabase db push --include-all

backfill_user_settings:
	psql "$(PG_CONN)" -c "INSERT INTO public.user_settings (user_id) SELECT id FROM auth.users ON CONFLICT (user_id) DO NOTHING;"

init: snapshot_users reset deploy seed restore_snapshot_users backfill_user_settings
